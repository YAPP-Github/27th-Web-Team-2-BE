{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(./gradlew *ktlintFormat:*)",
      "Bash(./gradlew *build:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./gradlew ktlintFormat --quiet"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
